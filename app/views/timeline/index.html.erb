<% content_for :title, "時系列" %>

<h2>時系列</h2>

<p class="filters">
  <%= link_to "すべて", root_path, class: ("on" if @kind.nil?) %>
  <% Subject::KINDS.each do |kind| %>
    <%= link_to kind_label(kind), root_path(kind: kind), class: ("on" if @kind == kind) %>
  <% end %>
</p>

<ol class="timeline">
  <%= render partial: "events/event", collection: @events %>
</ol>

<% if @events.empty? %>
  <p class="empty">まだ何もない。上のメニューから記録する。</p>
<% end %>
