<%# 映画のフォーム。books / dishes / places / videos のコピー。統合しないこと (DESIGN.md)。 %>
<% content_for :title, "映画を記録する" %>

<h2>映画を記録する</h2>

<%= form_with url: films_path, scope: nil, multipart: true, class: "record" do |f| %>
  <%= render "shared/errors", records: [ @subject, @event ] %>

  <fieldset>
    <legend>映画</legend>
    <label>タイトル<%= text_field_tag "subject[title]", @subject.title, required: true, autofocus: true %></label>
    <label>監督<%= text_field_tag "subject[creator]", @subject.creator %></label>
    <label>TMDB ID<%= text_field_tag "subject[tmdb]", @subject.external_ids["tmdb"] %></label>
    <label>URL<%= url_field_tag "subject[url]", @subject.external_ids["url"] %></label>
    <%= render "shared/cover_fields", image_url: @image_url %>
  </fieldset>

  <fieldset>
    <legend>できごと</legend>
    <label>種別<%= select_tag "event[type]", options_for_select(Event::TYPES.map { |t| [ type_label(t, "film"), t ] }, @event.type) %></label>
    <%= render "shared/fuzzy_date_fields", value: @event.occurred_on %>
    <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
    <label>きっかけ<%= select_tag "event[caused_by]", options_for_select(@causes.map { |e| [ "#{FuzzyDate.label(e.occurred_on)} #{e.subject.title} (#{type_label(e.type, e.subject.kind)})", e.id ] }, @event.caused_by), include_blank: "—" %></label>
    <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 3 %></label>
  </fieldset>

  <%= submit_tag "記録する" %>
<% end %>
