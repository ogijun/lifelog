<%# 料理のフォーム。books / films / places / videos のコピー。統合しないこと (DESIGN.md)。 %>
<% content_for :title, "料理を記録する" %>

<h2>料理を記録する</h2>

<%= form_with url: dishes_path, scope: nil, multipart: true, class: "record" do |f| %>
  <%= render "shared/errors", records: [ @subject, @event ] %>

  <fieldset>
    <legend>料理</legend>
    <label>料理名<%= text_field_tag "subject[title]", @subject.title, required: true, autofocus: true %></label>
    <label>出典・作った人<%= text_field_tag "subject[creator]", @subject.creator %></label>
    <label>レシピ URL<%= url_field_tag "subject[recipe_url]", @subject.external_ids["recipe_url"] %></label>
    <%= render "shared/cover_fields", image_url: @image_url %>
  </fieldset>

  <fieldset>
    <legend>できごと</legend>
    <%= render "shared/type_fields", kind: "dish", selected: @event.type %>
    <%= render "shared/fuzzy_date_fields", value: @event.occurred_on %>
    <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
    <label>きっかけ<%= select_tag "event[caused_by]", options_for_select(@causes.map { |e| [ "#{FuzzyDate.label(e.occurred_on)} #{e.subject.title} (#{type_label(e.type, e.subject.kind)})", e.id ] }, @event.caused_by), include_blank: "—" %></label>
    <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 3 %></label>
  </fieldset>

  <%= submit_tag "記録する" %>
<% end %>
