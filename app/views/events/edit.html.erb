<% content_for :title, "#{@event.subject.title} の記録を直す" %>

<h2>
  <span class="kind kind-<%= @event.subject.kind %>"><%= kind_label(@event.subject.kind) %></span>
  <%= link_to @event.subject.title, @event.subject %>
</h2>

<%= form_with url: event_path(@event), method: :patch, scope: nil, class: "record" do %>
  <%= render "shared/errors", records: [ @event ] %>
  <p>種別: <span class="type type-<%= @event.type %>"><%= type_label(@event.type, @event.subject.kind) %></span> <small>(種別は直せない。違っていたら追記する)</small></p>
  <%= render "shared/fuzzy_date_fields", value: @event.occurred_on %>
  <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
  <%= render "shared/source_field", value: @event.source_url %>
  <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 3 %></label>
  <%= submit_tag "直す" %>
<% end %>
