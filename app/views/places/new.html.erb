<%# 店 (外食の飲食店) のフォーム。kind は place のまま。books / films / dishes / videos のコピー。統合しないこと (DESIGN.md)。 %>
<% content_for :title, "店を記録する" %>

<h2>店を記録する</h2>
<p class="hint"><%= link_to "ブックマークレット", bookmarklet_path %>を使うと Google マップから開ける。</p>

<%= form_with url: places_path, scope: nil, multipart: true, class: "record" do |f| %>
  <%= render "shared/errors", records: [ @subject, @event ] %>

  <fieldset>
    <legend>店</legend>
    <label>店名<%= text_field_tag "subject[title]", @subject.title, required: true, autofocus: true %></label>
    <label>ジャンル<%= text_field_tag "subject[creator]", @subject.creator %></label>
    <label>緯度<%= number_field_tag "subject[lat]", @subject.lat, step: "any" %></label>
    <label>経度<%= number_field_tag "subject[lng]", @subject.lng, step: "any" %></label>
    <label>Google Place ID<%= text_field_tag "subject[google_place]", @subject.external_ids["google_place"] %></label>
    <label>URL<%= url_field_tag "subject[url]", @subject.external_ids["url"] %></label>
    <%= render "shared/cover_fields", image_url: @image_url %>
  </fieldset>

  <fieldset>
    <legend>できごと</legend>
    <%= render "shared/type_fields", kind: "place", selected: @event.type %>
    <%= render "shared/fuzzy_date_fields", value: @event.occurred_on %>
    <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
    <label>きっかけ<%= select_tag "event[caused_by]", options_for_select(@causes.map { |e| [ "#{FuzzyDate.label(e.occurred_on)} #{e.subject.title} (#{type_label(e.type, e.subject.kind)})", e.id ] }, @event.caused_by), include_blank: "—" %></label>
    <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 3 %></label>
  </fieldset>

  <%= submit_tag "記録する" %>
<% end %>
