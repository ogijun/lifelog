<% content_for :title, "#{@subject.title} を記録する" %>

<h2>
  <span class="kind kind-<%= @subject.kind %>"><%= kind_label(@subject.kind) %></span>
  <%= link_to @subject.title, @subject %>
</h2>

<%= form_with url: subject_transition_path(@subject), scope: nil, class: "record" do %>
  <%= render "shared/errors", records: [ @event ] %>
  <%= render "shared/type_fields", kind: @subject.kind, selected: @event.type %>
  <%= render "shared/fuzzy_date_fields", value: @event.occurred_on %>
  <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
  <%= render "shared/source_field", value: @event.source_url %>
  <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 3 %></label>
  <%= submit_tag "記録する" %>
<% end %>
