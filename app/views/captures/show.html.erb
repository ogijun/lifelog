<% content_for :title, "何として記録する？" %>

<h2>何として記録する？</h2>
<p class="hint"><%= @name.presence || @url %></p>

<% if @candidates.any? %>
  <h3>このページから見つかったもの</h3>
  <ul class="candidates">
    <% @candidates.each do |hit| %>
      <li>
        <%= link_to public_send("new_#{hit.kind}_path", subject: hit.subject, source_url: @url) do %>
          <span class="kind kind-<%= hit.kind %>"><%= kind_label(hit.kind) %></span> <%= hit.subject[:title] %>
        <% end %>
        <small><%= URI(hit.subject[:url]).host %></small>
      </li>
    <% end %>
  </ul>
  <h3>ほかのものとして記録する</h3>
<% end %>

<ul class="kind-choice">
  <li><%= link_to "本", new_book_path(choice_params(:url)) %></li>
  <li><%= link_to "映画", new_film_path(choice_params(:url)) %></li>
  <li><%= link_to "料理", new_dish_path(choice_params(:recipe_url)) %></li>
  <li><%= link_to "店", new_place_path(choice_params(:url)) %></li>
  <li><%= link_to "動画", new_video_path(choice_params(:url)) %></li>
</ul>
