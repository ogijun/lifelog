<%# いまの状態と、次に進めるボタン。locals: subject:, state: %>
<div class="state">
  <% if state %>
    <%= state_stamp(state.status, subject.kind, large: true) %>
    <span class="as-of"><%= FuzzyTimestamp.label(state.as_of) %> 時点</span>
    <%= render "shared/transition_buttons", subject:, status: state.status, detailed: true %>
  <% else %>
    <span class="as-of">まだ何もない</span>
  <% end %>
</div>
