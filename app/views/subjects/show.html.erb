<% content_for :title, @subject.title %>

<h2>
  <span class="kind kind-<%= @subject.kind %>"><%= kind_label(@subject.kind) %></span>
  <%= @subject.title %>
</h2>
<% if @subject.creator.present? %><p class="creator"><%= @subject.creator %></p><% end %>

<div class="cover-box">
  <%= cover_image(@subject, "cover") %>
  <%= form_with url: subject_cover_path(@subject), method: :patch, multipart: true, class: "cover-form" do %>
    <label><%= @subject.cover.attached? ? "画像を差し替える" : "画像を付ける" %>
      <%= file_field_tag :cover, accept: Subject::COVER_TYPES.join(","), required: true %></label>
    <%= submit_tag "保存" %>
  <% end %>
  <% if @subject.cover.attached? %>
    <%= button_to "画像を外す", subject_cover_path(@subject), method: :delete, class: "undo",
          form: { data: { turbo_confirm: "画像を外す？" } } %>
  <% end %>
</div>

<%= turbo_frame_tag "state" do %>
  <%= render "subjects/state", subject: @subject, state: @state %>
<% end %>

<h3>日付や評価をつけて記録する</h3>
<%= form_with url: subject_events_path(@subject), scope: nil, class: "record" do %>
  <%= render "shared/errors", records: [ @event ] %>
  <%= render "shared/type_fields", kind: @subject.kind, selected: @event.type %>
  <%= render "shared/fuzzy_date_fields", value: @event.occurred_on, legend: "新しいできごとの日付" %>
  <label>評価<%= select_tag "event[rating]", options_for_select((1..5).map { |n| [ "★" * n, n ] }, @event.rating), include_blank: "—" %></label>
  <label>メモ<%= text_area_tag "event[note]", @event.note, rows: 2 %></label>
  <%= submit_tag "記録する" %>
<% end %>

<h3>これまで</h3>
<ol class="timeline" id="events">
  <%= render partial: "events/event", collection: @events %>
</ol>

<% if @subject.external_ids.any? %>
  <h3>外部 ID</h3>
  <dl class="external-ids">
    <% @subject.external_ids.each do |key, value| %>
      <dt><%= key %></dt><dd><%= external_link(value) %></dd>
    <% end %>
  </dl>
<% end %>
